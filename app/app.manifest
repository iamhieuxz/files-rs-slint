<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="FilesRS.app" type="win32" />

  <!--
    Yêu cầu quyền administrator: app đọc được mọi ổ đĩa, xoá vào Thùng rác của
    hệ thống, ghi file association vào HKEY_CLASSES_ROOT.

    `highestAvailable` thay vì `requireAdministrator`: người dùng thuộc nhóm
    Administrators sẽ được nâng quyền, còn tài khoản thường vẫn chạy được thay
    vì bị chặn hoàn toàn. Nếu bắt buộc phải admin tuyệt đối, đổi thành
    `requireAdministrator` — nhưng khi đó app không chạy được trên máy bị hạn chế.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="highestAvailable" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- Nhận diện Windows 10/11 để dùng đúng theme và DPI. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <!-- Per-monitor DPI v2: không bị nhòe khi kéo sang màn hình có tỉ lệ khác. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
