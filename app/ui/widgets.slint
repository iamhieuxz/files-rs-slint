// Fluent 2 control primitives.
//
// Mỗi control ở đây tương ứng một control WinUI mà Files dùng, giữ đúng các
// trạng thái Rest / PointerOver / Pressed / Selected / Disabled và đúng bán kính
// bo góc của Fluent 2 (4px cho control, 7px cho khối nổi).

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { FluentIcon } from "icons.slint";

// ---- Nút chữ + icon (Button) ----
export component FluentButton inherits Rectangle {
    in property <string> label: "";
    in property <string> icon: "";
    in property <bool> enabled: true;
    in property <bool> accent: false;
    in property <bool> show-label: true;
    callback clicked();

    accessible-role: button;
    accessible-label: root.label != "" ? root.label : root.icon;
    accessible-enabled: root.enabled;
    // Screen reader / UIA cần action mặc định để bấm được nút, không chỉ đọc tên.
    accessible-action-default => { if (root.enabled) { ta.clicked(); } }

    height: Theme.control-height;
    min-width: 32px;
    border-radius: Theme.r-sm;
    background: !root.enabled ? transparent
        : root.accent ? (ta.pressed ? Theme.accent-pressed : (ta.has-hover ? Theme.accent-hover : Theme.accent))
        : ta.pressed ? Theme.subtle-pressed
        : ta.has-hover ? Theme.subtle-hover
        : transparent;
    border-width: root.accent ? 0px : 1px;
    border-color: Theme.stroke;
    animate background { duration: 90ms; }

    HorizontalLayout {
        padding-left: root.icon == "" ? Theme.s3 : Theme.s2;
        padding-right: root.icon == "" ? Theme.s3 : Theme.s3;
        spacing: Theme.s2;
        alignment: center;

        if root.icon != "": FluentIcon {
            name: root.icon;
            width: 16px;
            height: 16px;
            tint: !root.enabled ? Theme.text-disabled
                : root.accent ? Theme.text-on-accent
                : Theme.text-primary;
        }
        if root.show-label && root.label != "": Text {
            text: root.label;
            color: !root.enabled ? Theme.text-disabled
                : root.accent ? Theme.text-on-accent
                : Theme.text-primary;
            font-size: Theme.font-body;
            font-weight: Theme.weight-regular;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// ---- Nút chỉ có icon (IconButton), 32x32 ----
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    in property <bool> checked: false;
    /// Nhãn cho trình đọc màn hình. Tên icon ("clipboard_paste") không phải
    /// tiếng người, nên nơi dùng phải đặt nhãn thật.
    in property <string> accessible-text: "";
    callback clicked();

    accessible-role: button;
    accessible-label: root.accessible-text != "" ? root.accessible-text : root.icon;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { ta.clicked(); } }

    width: 32px;
    height: 32px;
    border-radius: Theme.r-sm;
    background: !root.enabled ? transparent
        : root.checked ? Theme.accent-subtle
        : ta.pressed ? Theme.subtle-pressed
        : ta.has-hover ? Theme.subtle-hover
        : transparent;
    animate background { duration: 90ms; }

    FluentIcon {
        name: root.icon;
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        tint: !root.enabled ? Theme.text-disabled
            : root.checked ? Theme.accent
            : Theme.text-primary;
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// ---- Nút có icon + nhãn + mũi tên tách rời, dùng cho hàng lệnh chính ----
export component CommandButton inherits Rectangle {
    accessible-role: button;
    accessible-label: root.label != "" ? root.label : root.icon;
    accessible-action-default => { if (root.enabled) { ta.clicked(); } }
    in property <string> label;
    in property <string> icon;
    in property <bool> enabled: true;
    in property <bool> split: false;
    callback clicked();
    callback menu-clicked();

    height: Theme.control-height;
    border-radius: Theme.r-sm;
    background: !root.enabled ? transparent
        : ta.pressed ? Theme.subtle-pressed
        : ta.has-hover ? Theme.subtle-hover
        : transparent;
    animate background { duration: 90ms; }

    HorizontalLayout {
        padding-left: Theme.s2;
        padding-right: root.split ? Theme.s1 : Theme.s3;
        spacing: Theme.s2;
        alignment: center;
        cross-axis-alignment: center;
        FluentIcon {
            name: root.icon;
            width: 16px;
            height: 16px;
            tint: root.enabled ? Theme.text-primary : Theme.text-disabled;
        }
        Text {
            text: root.label;
            color: root.enabled ? Theme.text-primary : Theme.text-disabled;
            font-size: Theme.font-body;
            vertical-alignment: center;
        }
        if root.split: Rectangle {
            width: 20px;
            height: parent.height;
            border-radius: Theme.r-sm;
            background: split-ta.pressed ? Theme.subtle-pressed
                : split-ta.has-hover ? Theme.subtle-hover : transparent;
            FluentIcon {
                name: "chevron_down";
                width: 12px;
                height: 12px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                tint: root.enabled ? Theme.text-secondary : Theme.text-disabled;
            }
            split-ta := TouchArea {
                enabled: root.enabled;
                clicked => { root.menu-clicked(); }
            }
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// ---- Mục sidebar: icon màu + nhãn, chọn bằng thanh accent dọc bên trái ----
export component SidebarItem inherits Rectangle {
    in property <string> label;
    in property <string> icon: "folder";
    in property <color> glyph: Theme.glyph-folder;
    in property <bool> active: false;
    in property <int> indent: 0;
    in property <bool> expandable: false;
    in property <bool> expanded: false;
    // Đích thả tệp từ Explorer/khung khác và trạng thái rê lên mục này.
    in property <string> drop-path;
    in property <bool> drop-active: false;
    callback clicked();
    callback toggle-expanded();
    callback geometry(string, length, length, length, length);
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { ta.clicked(); }

    height: 36px;
    border-radius: Theme.r-sm;
    border-width: root.drop-active ? 1px : 0px;
    border-color: Theme.accent;
    background: root.drop-active ? Theme.accent-subtle
        : root.active ? Theme.subtle-selected
        : ta.has-hover ? Theme.subtle-hover
        : transparent;
    animate background { duration: 90ms; }

    function report-geometry() {
        root.geometry(
            root.drop-path,
            self.absolute-position.x,
            self.absolute-position.y,
            self.width,
            self.height,
        );
    }
    init => { root.report-geometry(); }
    changed absolute-position => { root.report-geometry(); }
    changed width => { root.report-geometry(); }
    changed height => { root.report-geometry(); }

    // Thanh accent dọc: dấu hiệu "đang ở đây" của Fluent NavigationView.
    if root.active: Rectangle {
        x: 0;
        y: 9px;
        width: 3px;
        height: parent.height - 18px;
        border-radius: 1.5px;
        background: Theme.accent;
    }

    HorizontalLayout {
        padding-left: Theme.s3 + root.indent * 18px;
        padding-right: Theme.s2;
        spacing: Theme.s3;
        alignment: start;

        if root.expandable: Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            FluentIcon {
                name: root.expanded ? "chevron_down" : "chevron_right";
                width: 12px;
                height: 12px;
                x: 2px;
                y: 2px;
                tint: Theme.text-tertiary;
            }
            TouchArea { clicked => { root.toggle-expanded(); } }
        }

        FluentIcon {
            name: root.icon;
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            tint: root.glyph;
        }
        Text {
            text: root.label;
            color: Theme.text-primary;
            font-size: Theme.font-body;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    ta := TouchArea { clicked => { root.clicked(); } }
}

// ---- Tab: nền chuyển theo trạng thái, bo góc trên ----
export component TabItem inherits Rectangle {
    in property <string> label;
    in property <string> icon: "";
    in property <bool> active: false;
    callback clicked();
    callback closed();
    callback right-clicked();
    accessible-role: tab;
    accessible-label: root.label;
    accessible-action-default => { ta.clicked(); }

    height: Theme.tab-height - 6px;
    min-width: 140px;
    max-width: 240px;
    border-radius: Theme.r-md;
    background: root.active ? Theme.tab-active
        : ta.has-hover ? Theme.subtle-hover
        : transparent;
    animate background { duration: 90ms; }

    // Vùng chọn tab: KHÔNG phủ 30px cuối, để nút đóng không bị tranh chấp.
    ta := TouchArea {
        width: root.width - 30px;
        height: root.height;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.right-clicked();
            }
        }
    }

    HorizontalLayout {
        padding-left: Theme.s3;
        padding-right: 30px;
        spacing: Theme.s2;
        // Tab giống Files: icon và chữ bám trái; khoảng trống dồn về phía nút đóng.
        alignment: start;

        if root.icon != "": FluentIcon {
            name: root.icon;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            tint: root.active ? Theme.accent : Theme.text-secondary;
        }
        Text {
            text: root.label;
            color: root.active ? Theme.text-primary : Theme.text-secondary;
            font-size: Theme.font-body;
            vertical-alignment: center;
            max-width: 170px;
            overflow: elide;
        }
    }

    // Nút đóng: dải 30px ở mép phải, khai báo sau cùng và KHÔNG chồng lên `ta`.
    Rectangle {
        x: root.width - 30px;
        y: 0;
        width: 30px;
        height: root.height;
        background: close-ta.has-hover ? Theme.subtle-pressed : transparent;
        FluentIcon {
            name: "dismiss";
            width: 12px;
            height: 12px;
            x: 9px;
            y: (parent.height - 12px) / 2;
            tint: close-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
        }
        close-ta := TouchArea {
            clicked => { root.closed(); }
        }
    }
}

// ---- Ô nhập văn bản theo kiểu Fluent TextBox ----
export component FluentTextBox inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: "";
    in property <string> leading-icon: "";
    in property <bool> read-only: false;
    callback accepted();
    callback edited(string);
    // Esc trong ô nhập: dùng cho ô lọc, nơi Escape không bubble lên FocusScope.
    callback cancelled();

    height: Theme.control-height;
    border-radius: Theme.r-sm;
    background: Theme.solid-tertiary;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.stroke-strong;
    // Fluent vẽ gạch accent 2px ở đáy khi focus.
    if input.has-focus: Rectangle {
        y: parent.height - 2px;
        height: 2px;
        width: parent.width;
        border-radius: 1px;
        background: Theme.accent;
    }
    // Placeholder: trước đây property tồn tại nhưng không được vẽ, nên ô search
    // trông như một khung rỗng chỉ có icon.
    if root.text == "": Text {
        x: Theme.s3 + (root.leading-icon != "" ? 16px + Theme.s2 : 0px);
        y: (parent.height - self.height) / 2;
        width: parent.width - self.x - Theme.s3;
        text: root.placeholder;
        color: Theme.text-tertiary;
        font-size: Theme.font-body;
        vertical-alignment: center;
        overflow: elide;
    }
    animate border-color { duration: 100ms; }

    HorizontalLayout {
        padding-left: Theme.s3;
        padding-right: Theme.s3;
        spacing: Theme.s2;
        // stretch theo trục ngang để icon bám trái và input chiếm phần còn lại;
        // cross-axis căn giữa theo chiều dọc. `alignment: center` trước đây
        // căn icon ra giữa ô, lệch hẳn khỏi dòng chữ.
        alignment: stretch;
        cross-axis-alignment: center;

        if root.leading-icon != "": FluentIcon {
            name: root.leading-icon;
            width: 16px;
            height: 16px;
            tint: Theme.text-secondary;
        }
        input := TextInput {
            horizontal-stretch: 1;
            vertical-alignment: center;
            color: Theme.text-primary;
            font-size: Theme.font-body;
            single-line: true;
            read-only: root.read-only;
            accepted => { root.accepted(); }
            edited => { root.edited(self.text); }
            key-pressed(event) => {
                if (event.text == Key.Escape) { root.cancelled(); return accept; }
                reject
            }
            // Ô lọc chỉ được tạo khi người dùng bấm Ctrl+F: focus ngay để gõ
            // được mà không phải click thêm.
            init => { self.focus(); }
        }
    }
}

// ---- Hộp thoại nổi (ContentDialog) ----
export component DialogSurface inherits Rectangle {
    in property <string> title;
    in property <string> primary-label: "OK";
    in property <string> secondary-label: "";
    in property <bool> primary-enabled: true;
    callback primary();
    callback secondary();
    callback cancelled();

    width: 440px;
    // Chiều cao suy ra từ nội dung: title + @children + hàng nút, cộng padding
    // hai đầu. Đặt cứng 220px thì hộp thoại xác nhận (không có ô nhập) thừa
    // một khoảng trống lớn.
    height: layout.preferred-height + Theme.s5 * 2;
    border-radius: Theme.r-lg;
    background: Theme.solid-tertiary;
    border-width: 1px;
    border-color: Theme.stroke-strong;
    drop-shadow-blur: 32px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 8px;

    layout := VerticalLayout {
        padding: Theme.s5;
        spacing: Theme.s4;
        Text {
            text: root.title;
            color: Theme.text-primary;
            font-size: Theme.font-title;
            font-weight: Theme.weight-semibold;
            font-family: Theme.font-family-display;
            wrap: word-wrap;
        }
        Rectangle { vertical-stretch: 1; @children }
        HorizontalLayout {
            alignment: end;
            spacing: Theme.s2;
            FluentButton { label: "Huỷ"; clicked => { root.cancelled(); } }
            if root.secondary-label != "": FluentButton {
                label: root.secondary-label;
                clicked => { root.secondary(); }
            }
            FluentButton {
                label: root.primary-label;
                accent: true;
                enabled: root.primary-enabled;
                clicked => { root.primary(); }
            }
        }
    }
}

// ---- Menu ngữ cảnh (MenuFlyout) ----
export struct MenuItem {
    id: string,
    label: string,
    icon: string,
    shortcut: string,
    enabled: bool,
    separator: bool,
    // Chấm màu trước nhãn. Dùng cho mục thẻ; `has-dot` false thì không vẽ,
    // vì Slint không cho đọc kênh alpha của `color`.
    dot: color,
    has-dot: bool,
    // Nhãn nhóm (ví dụ "Thẻ màu", "Mở bằng"): hiển thị mờ, không bấm được.
    header: bool,
    // Mục mở menu con; vẽ chevron ở cuối.
    submenu: bool,
}

export component MenuPopup inherits Rectangle {
    in property <[MenuItem]> items;
    callback activated(string);

    // Rộng hơn để nhãn + phím tắt không lọt ra ngoài; cao tối đa 480px rồi cuộn.
    width: 300px;
    height: min(items.length * 30px + Theme.s2 + Theme.s2, 480px);
    border-radius: Theme.r-md;
    background: Theme.solid-tertiary;
    border-width: 1px;
    border-color: Theme.stroke-strong;
    drop-shadow-blur: 20px;
    drop-shadow-color: #00000033;
    drop-shadow-offset-y: 4px;

    VerticalLayout {
        padding: Theme.s1;
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 0px;
                for item[i] in root.items: Rectangle {
                    height: 30px;
                    border-radius: Theme.r-sm;
                    background: mi.has-hover && item.enabled && !item.separator && !item.header ? Theme.subtle-hover : transparent;
                    if item.separator: Rectangle {
                        height: 1px;
                        width: parent.width - Theme.s2 * 2;
                        x: Theme.s2;
                        y: 14px;
                        background: Theme.stroke-divider;
                    }
                    if !item.separator: HorizontalLayout {
                        padding-left: Theme.s3;
                        padding-right: Theme.s2;
                        spacing: Theme.s2;
                        alignment: stretch;
                        if item.has-dot: Rectangle {
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            y: (parent.height - self.height) / 2;
                            background: item.dot;
                        }
                        if item.icon != "": FluentIcon {
                            name: item.icon;
                            width: 16px;
                            height: 16px;
                            y: (parent.height - self.height) / 2;
                            tint: item.enabled ? Theme.text-primary : Theme.text-disabled;
                        }
                        Text {
                            text: item.label;
                            color: item.header ? Theme.text-tertiary : (item.enabled ? Theme.text-primary : Theme.text-disabled);
                            font-size: item.header ? Theme.font-caption : Theme.font-body;
                            font-weight: item.header ? Theme.weight-semibold : Theme.weight-regular;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        if item.submenu: FluentIcon {
                            name: "chevron_right";
                            width: 12px;
                            height: 12px;
                            y: (parent.height - self.height) / 2;
                            tint: item.enabled ? Theme.text-secondary : Theme.text-disabled;
                        }
                        if item.shortcut != "" && !item.header: Text {
                            text: item.shortcut;
                            color: Theme.text-tertiary;
                            font-size: Theme.font-caption;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            overflow: elide;
                        }
                    }
                    mi := TouchArea {
                        enabled: item.enabled && !item.separator && !item.header;
                        clicked => { root.activated(item.id); }
                    }
                }
            }
        }
    }
}

// ---- Nút điều khiển cửa sổ kiểu Windows 11 ----
export component WindowControl inherits Rectangle {
    // "minimize" | "maximize" | "restore" | "close"
    in property <string> kind;
    callback clicked();

    accessible-role: button;
    accessible-label: kind == "minimize" ? "Thu nhỏ"
        : kind == "maximize" ? "Phóng to"
        : kind == "restore" ? "Khôi phục"
        : "Đóng";
    accessible-action-default => { ta.clicked(); }

    width: 46px;
    height: 32px;
    background: ta.has-hover
        ? (kind == "close" ? #c42b1c : Theme.subtle-hover)
        : transparent;

    if kind == "minimize": Rectangle {
        width: 12px;
        height: 1px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.text-primary;
    }
    if kind == "maximize": Rectangle {
        width: 11px;
        height: 11px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: transparent;
        border-width: 1px;
        border-color: Theme.text-primary;
    }
    if kind == "restore": Rectangle {
        x: (parent.width - 11px) / 2 + 2px;
        y: (parent.height - 11px) / 2 - 2px;
        width: 9px;
        height: 9px;
        background: transparent;
        border-width: 1px;
        border-color: Theme.text-primary;
    }
    if kind == "restore": Rectangle {
        x: (parent.width - 11px) / 2 - 1px;
        y: (parent.height - 11px) / 2;
        width: 9px;
        height: 9px;
        background: Theme.solid-base;
        border-width: 1px;
        border-color: Theme.text-primary;
    }
    if kind == "close": FluentIcon {
        name: "dismiss";
        width: 13px;
        height: 13px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        tint: ta.has-hover ? #ffffff : Theme.text-primary;
    }

    ta := TouchArea { clicked => { root.clicked(); } }
}

// ---- Vạch ngăn giữa các nhóm lệnh trên command bar ----
export component CommandSeparator inherits Rectangle {
    width: 9px;
    height: 32px;
    Rectangle {
        x: (parent.width - 1px) / 2;
        y: (parent.height - 20px) / 2;
        width: 1px;
        height: 20px;
        background: Theme.stroke-divider;
    }
}

// ---- Chip hiển thị chế độ clipboard (Copy/Cut đang giữ bao nhiêu mục) ----
export component ClipboardChip inherits Rectangle {
    in property <string> mode;
    in property <int> count: 0;

    height: 24px;
    border-radius: Theme.r-md;
    background: Theme.accent-subtle;
    HorizontalLayout {
        padding-left: Theme.s2;
        padding-right: Theme.s3;
        spacing: Theme.s1;
        alignment: center;
        FluentIcon {
            name: root.mode == "cut" ? "cut" : "copy";
            width: 12px;
            height: 12px;
            tint: Theme.accent;
        }
        Text {
            text: root.mode == "cut" ? ("Đã cắt " + root.count) : ("Đã sao chép " + root.count);
            color: Theme.accent;
            font-size: Theme.font-caption;
            vertical-alignment: center;
        }
    }
}
