// Icon phẳng vẽ bằng Path (nét 1.6, bo đầu nét). Không phụ thuộc file ngoài.
// Hệ tọa độ viewBox 24x24, nét thuần, không đổ bóng.

export component Icon inherits Rectangle {
    in property <string> name;
    in property <color> tint: #f3f4f6;
    in property <bool> filled: false;
    width: 16px;
    height: 16px;
    background: transparent;

    if root.name == "back": Path {
        width: parent.width; height: parent.height;
        viewbox-width: 24; viewbox-height: 24;
        stroke: root.tint; stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round;
        fill: transparent;
        commands: "M15 5 L8 12 L15 19";
    }
    if root.name == "forward": Path {
        width: parent.width; height: parent.height;
        viewbox-width: 24; viewbox-height: 24;
        stroke: root.tint; stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round;
        fill: transparent;
        commands: "M9 5 L16 12 L9 19";
    }
    if root.name == "up": Path {
        width: parent.width; height: parent.height;
        viewbox-width: 24; viewbox-height: 24;
        stroke: root.tint; stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round;
        fill: transparent;
        commands: "M5 15 L12 8 L19 15";
    }
    if root.name == "refresh": Path {
        width: parent.width; height: parent.height;
        viewbox-width: 24; viewbox-height: 24;
        stroke: root.tint; stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round;
        fill: transparent;
        commands: "M19 12 A7 7 0 1 1 16.5 6.6 M19 4 L19 9 L14 9";
    }
    if root.name == "search": Path {
        width: parent.width; height: parent.height;
        viewbox-width: 24; viewbox-height: 24;
        stroke: root.tint; stroke-width: 1.8px; stroke-line-cap: round;
        fill: transparent;
        commands: "M11 4 A7 7 0 1 0 11 18 A7 7 0 1 0 11 4 M16 16 L20 20";
    }
    if root.name == "folder": Path {
        width: parent.width; height: parent.height;
        viewbox-width: 24; viewbox-height: 24;
        fill: root.tint; stroke: transparent;
        commands: "M3 6 Q3 5 4 5 L9 5 L11 7 L20 7 Q21 7 21 8 L21 18 Q21 19 20 19 L4 19 Q3 19 3 18 Z";
    }
    if root.name == "file": Path {
        width: parent.width; height: parent.height;
        viewbox-width: 24; viewbox-height: 24;
        stroke: root.tint; stroke-width: 1.6px; stroke-line-join: round;
        fill: transparent;
        commands: "M6 3 L14 3 L19 8 L19 21 L6 21 Z M14 3 L14 8 L19 8";
    }
    if root.name == "image": Path {
        width: parent.width; height: parent.height;
        viewbox-width: 24; viewbox-height: 24;
        stroke: root.tint; stroke-width: 1.6px; stroke-line-join: round;
        fill: transparent;
        commands: "M4 4 L20 4 L20 20 L4 20 Z M4 16 L9 11 L13 15 L16 12 L20 16";
    }
    if root.name == "code": Path {
        width: parent.width; height: parent.height;
        viewbox-width: 24; viewbox-height: 24;
        stroke: root.tint; stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round;
        fill: transparent;
        commands: "M9 7 L4 12 L9 17 M15 7 L20 12 L15 17";
    }
    if root.name == "doc": Path {
        width: parent.width; height: parent.height;
        viewbox-width: 24; viewbox-height: 24;
        stroke: root.tint; stroke-width: 1.6px; stroke-line-join: round;
        fill: transparent;
        commands: "M6 3 L14 3 L19 8 L19 21 L6 21 Z M9 13 L16 13 M9 17 L14 17";
    }
    if root.name == "archive": Path {
        width: parent.width; height: parent.height;
        viewbox-width: 24; viewbox-height: 24;
        stroke: root.tint; stroke-width: 1.6px; stroke-line-join: round;
        fill: transparent;
        commands: "M4 4 L20 4 L20 9 L4 9 Z M5 9 L5 20 L19 20 L19 9 M10 13 L14 13";
    }
    if root.name == "media": Path {
        width: parent.width; height: parent.height;
        viewbox-width: 24; viewbox-height: 24;
        fill: root.tint; stroke: transparent;
        commands: "M9 5 L19 12 L9 19 Z";
    }
    if root.name == "drive": Path {
        width: parent.width; height: parent.height;
        viewbox-width: 24; viewbox-height: 24;
        stroke: root.tint; stroke-width: 1.8px; stroke-line-cap: round; stroke-line-join: round;
        fill: transparent;
        commands: "M3 14 L6 6 L18 6 L21 14 L21 18 L3 18 Z M3 14 L21 14";
    }
    if root.name == "star": Path {
        width: parent.width; height: parent.height;
        viewbox-width: 24; viewbox-height: 24;
        stroke: root.tint; stroke-width: 1.6px; stroke-line-join: round;
        fill: transparent;
        commands: "M12 4 L14.5 9.5 L20.5 10.2 L16 14.2 L17.3 20 L12 17 L6.7 20 L8 14.2 L3.5 10.2 L9.5 9.5 Z";
    }
    if root.name == "close": Path {
        width: parent.width; height: parent.height;
        viewbox-width: 24; viewbox-height: 24;
        stroke: root.tint; stroke-width: 1.8px; stroke-line-cap: round;
        fill: transparent;
        commands: "M6 6 L18 18 M18 6 L6 18";
    }
    if root.name == "plus": Path {
        width: parent.width; height: parent.height;
        viewbox-width: 24; viewbox-height: 24;
        stroke: root.tint; stroke-width: 1.8px; stroke-line-cap: round;
        fill: transparent;
        commands: "M12 5 L12 19 M5 12 L19 12";
    }
}
