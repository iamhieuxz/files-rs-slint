// Khung ứng dụng: tab strip, command bar, breadcrumb/omnibar, sidebar, danh sách,
// preview pane, status bar. Bố cục theo Files (files.community): tab ở trên cùng,
// thanh lệnh dưới tab, breadcrumb nằm trong command bar, sidebar bên trái,
// status bar ghim đáy.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { FluentIcon } from "icons.slint";
import {
    ClipboardChip, CommandButton, DialogSurface, FluentButton, FluentTextBox, IconButton,
    MenuItem, MenuPopup, SidebarItem, TabItem,
} from "widgets.slint";

// Rust cần `ui.global::<Theme>()` để bật dark mode, nên global phải được
// re-export từ document gốc.
export { Theme }

export struct FileRow {
    name: string,
    path: string,
    is-dir: bool,
    is-hidden: bool,
    selected: bool,
    size: string,
    modified: string,
    kind: string,
    icon: string,
    glyph: color,
    // Chữ cái trạng thái git (U/M/S/D/!), rỗng khi không có hoặc không phải repo.
    git-letter: string,
    git-color: color,
    // Icon thật của Windows (exe, msi, lnk…). Rỗng thì dùng `icon` + `glyph`.
    icon-image: image,
    has-icon-image: bool,
    // Vị trí trong danh sách đang hiển thị; cần cho grid vì ở đó mỗi ô
    // không còn chỉ số dòng như trong vòng lặp or row[i].
    index: int,
}

export struct NavEntry {
    id: string,
    label: string,
    path: string,
    icon: string,
    glyph: color,
    indent: int,
    expandable: bool,
    expanded: bool,
}

export struct TabInfo {
    title: string,
    path: string,
    icon: string,
}

export struct CrumbInfo {
    label: string,
    path: string,
    w: length,
}

// Một dòng của bảng thuộc tính (Properties).
export struct PropRow {
    label: string,
    value: string,
}

// Một lệnh trong Command Palette.
export struct PaletteEntry {
    id: string,
    label: string,
    icon: string,
    shortcut: string,
}

export component AppWindow inherits Window {
    title: "Files RS";
    preferred-width: 1240px;
    preferred-height: 800px;
    min-width: 760px;
    min-height: 480px;
    background: Theme.solid-base;
    default-font-family: Theme.font-family;
    // Bỏ khung cửa sổ của Windows: toàn bộ chrome do app tự vẽ, giống Files
    // (dùng AppWindowTitleBar + ExtendsContentIntoTitleBar). Viền mỏng 1px vẫn
    // được vẽ ở dưới để cửa sổ không "dính" vào nền phía sau.
    no-frame: true;
    init => { key-root.focus(); }

    // Trạng thái cửa sổ, Rust cập nhật sau mỗi lần người dùng bấm.
    in-out property <bool> is-maximized: false;

    // ---- dữ liệu vào ----
    in-out property <[TabInfo]> tabs;
    in-out property <int> active-tab: 0;
    in-out property <[CrumbInfo]> crumbs;
    in-out property <string> crumb-text;
    in-out property <string> address-text;
    in-out property <bool> editing-address: false;
    in-out property <[NavEntry]> pinned;
    in-out property <[NavEntry]> drives;
    in-out property <[FileRow]> rows;
    // Grid cần nhóm theo hàng: Slint GridLayout không tự xuống dòng.
    in-out property <[[FileRow]]> grid-rows;
    in-out property <int> selection-count: 0;
    // Mục đang chọn có phải tệp nén không (bật/tắt nút Giải nén).
    in-out property <bool> selection-is-archive: false;
    in-out property <string> status-primary;
    in-out property <string> status-secondary;
    in-out property <string> status-tertiary;
    in-out property <string> error-text;
    in-out property <bool> can-back: false;
    in-out property <bool> can-forward: false;
    in-out property <bool> show-hidden: false;
    in-out property <bool> show-sidebar: true;
    in-out property <bool> show-preview: true;
    in-out property <int> view-mode: 0;      // 0 = details, 1 = grid
    in-out property <string> sort-column: "name";
    in-out property <bool> sort-desc: false;
    in-out property <bool> folders-first: true;
    in-out property <string> filter-text;
    in-out property <bool> filtering: false;
    in-out property <string> clipboard-mode; // "" | "copy" | "cut"
    in-out property <int> clipboard-count: 0;
    in-out property <bool> busy: false;
    in-out property <string> busy-text;
    // Tiến trình của thao tác đang chạy: 0..1. Bằng 0 khi không có thao tác.
    in-out property <float> progress: 0;
    // Có thao tác đang chạy và huỷ được.
    in-out property <bool> cancellable: false;
    callback cancel-operation();

    // preview
    in-out property <string> preview-kind: "none";
    in-out property <image> preview-image;
    in-out property <string> preview-text;
    in-out property <string> preview-title;
    in-out property <string> preview-meta;
    // Bảng thuộc tính: các dòng nhãn/giá trị, dựng ở Rust.
    in-out property <[PropRow]> props;

    // hộp thoại
    in-out property <bool> dialog-open: false;
    in-out property <string> dialog-kind;    // rename | new-folder | new-file | confirm-delete
    in-out property <string> dialog-title;
    in-out property <string> dialog-text;
    in-out property <string> dialog-primary-label: "OK";
    in-out property <string> dialog-value;
    in-out property <bool> dialog-has-input: true;
    // Cho phép bấm nút chính khi ô nhập còn trống (lệnh tự sinh tên).
    in-out property <bool> dialog-allows-empty: false;
    // Nhãn nút phụ (rỗng = không hiện). Dùng cho hộp thoại trùng tên khi dán.
    in-out property <string> dialog-secondary-label;
    callback dialog-secondary();

    // menu ngữ cảnh
    in-out property <bool> menu-open: false;
    in-out property <length> menu-x;
    in-out property <length> menu-y;
    in-out property <[MenuItem]> menu-items;

    // Command Palette
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query;
    in-out property <[PaletteEntry]> palette-items;

    callback navigate(string);
    callback open-row(int);
    // mode: 0 = thay thế, 1 = shift (chọn khoảng), 2 = ctrl (thêm/bớt)
    callback select-row(int, int);
    callback go-back();
    callback go-forward();
    callback go-up();
    callback refresh();
    callback address-submitted(string);
    callback start-edit-address();
    callback sort-by(string);
    callback toggle-hidden();
    callback toggle-sidebar();
    callback toggle-preview();
    callback set-view-mode(int);
    callback new-tab();
    callback close-tab(int);
    callback select-tab(int);
    callback command(string);
    callback dialog-confirm(string);
    callback dialog-cancel();
    callback menu-activated(string);
    callback dismiss-menu();
    callback start-filter();
    callback filter-changed(string);
    callback end-filter();
    callback sidebar-activated(string);
    callback sidebar-toggled(string);
    callback row-context-menu(int, length, length);
    // Menu chuột phải trên tab; `menu-tab` cho biết tab đang nhắm tới.
    callback tab-context-menu(int, length, length);
    in-out property <int> menu-tab: -1;
    callback background-context-menu(length, length);
    callback toggle-theme();
    // Command Palette
    callback open-palette();
    callback close-palette();
    callback palette-changed(string);
    callback palette-accepted(string);
    // Điều khiển cửa sổ (title bar tự vẽ).
    callback window-minimize();
    callback window-toggle-maximize();
    callback window-close();
    callback window-drag(length, length);

    // ---- bàn phím ----
    key-root := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control) {
                if (event.text == "l") { root.start-edit-address(); return accept; }
                if (event.text == "t") {
                    // Ctrl+Shift+T mở lại tab vừa đóng; Ctrl+T mở tab mới.
                    if (event.modifiers.shift) { root.command("reopen-tab"); }
                    else { root.new-tab(); }
                    return accept;
                }
                if (event.text == "w") { root.close-tab(root.active-tab); return accept; }
                // Ctrl+Tab / Ctrl+Shift+Tab chuyển tab.
                if (event.text == Key.Tab) {
                    if (event.modifiers.shift) { root.command("prev-tab"); }
                    else { root.command("next-tab"); }
                    return accept;
                }
                if (event.text == "c") {
                    // Ctrl+Shift+C sao chép đường dẫn của mục đang chọn.
                    if (event.modifiers.shift) { root.command("copy-path"); }
                    else { root.command("copy"); }
                    return accept;
                }
                if (event.text == "x") { root.command("cut"); return accept; }
                if (event.text == "v") { root.command("paste"); return accept; }
                // Ctrl+Z hoàn tác, Ctrl+Shift+Z hoặc Ctrl+Y làm lại.
                if (event.text == "z") {
                    if (event.modifiers.shift) { root.command("redo"); }
                    else { root.command("undo"); }
                    return accept;
                }
                if (event.text == "y") { root.command("redo"); return accept; }
                if (event.text == "a") { root.command("select-all"); return accept; }
                if (event.text == "h") { root.command("toggle-hidden"); return accept; }
                if (event.text == "f") {
                    // Ctrl+Shift+F tìm đệ quy; Ctrl+F chỉ lọc trong thư mục.
                    if (event.modifiers.shift) { root.command("search-recursive"); }
                    else { root.start-filter(); }
                    return accept;
                }
                if (event.text == "r") { root.refresh(); return accept; }
                if (event.text == "d") { root.command("duplicate-tab"); return accept; }
                // Ctrl+Shift+P mở Command Palette.
                if (event.text == "p" && event.modifiers.shift) { root.open-palette(); return accept; }
            }
            if (event.text == Key.F5) { root.refresh(); return accept; }
            if (event.text == Key.F2) { root.command("rename"); return accept; }
            if (event.text == Key.Delete) {
                // Shift+Delete xoá vĩnh viễn, bỏ qua Thùng rác.
                if (event.modifiers.shift) { root.command("delete-permanent"); }
                else { root.command("delete"); }
                return accept;
            }
            if (event.text == Key.Backspace) { root.go-up(); return accept; }
            if (event.text == Key.Return && !root.editing-address && !root.dialog-open) {
                root.command("open-selected"); return accept;
            }
            if (event.text == Key.Escape) {
                if (root.palette-open) { root.close-palette(); return accept; }
                if (root.menu-open) { root.dismiss-menu(); return accept; }
                if (root.filtering) { root.end-filter(); return accept; }
                if (root.editing-address) { root.end-edit-address(); return accept; }
            }
            if (event.text == Key.UpArrow && !root.editing-address && !root.filtering) {
                root.command("nav-up"); return accept;
            }
            if (event.text == Key.DownArrow && !root.editing-address && !root.filtering) {
                root.command("nav-down"); return accept;
            }
            reject
        }
    }

    VerticalLayout {
        // ================= TITLE BAR TỰ VẼ =================
        // Cửa sổ không có khung Windows (no-frame), nên phần này thay cho
        // title bar hệ thống. Nút cửa sổ kiểu Windows 11: rộng 46px, hover nền
        // nhạt, riêng nút đóng hover đỏ.
        Rectangle {
            height: 36px;
            background: Theme.solid-secondary;

            // Vùng kéo khai báo TRƯỚC các nút để các nút nằm trên và nhận click.
            // Bề rộng chừa đúng 138px cho 3 nút cửa sổ bên phải.
            TouchArea {
                width: parent.width - 138px;
                height: parent.height;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        root.window-drag(self.mouse-x, self.mouse-y);
                    }
                }
            }

            HorizontalLayout {
                padding-left: Theme.s3;
                spacing: Theme.s2;
                FluentIcon {
                    name: "folder";
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                    tint: Theme.accent;
                }
                Text {
                    text: "Files RS";
                    color: Theme.text-secondary;
                    font-size: Theme.font-caption;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 0px;
                Rectangle {
                    width: 46px;
                    height: parent.height;
                    background: min-ta.has-hover ? Theme.subtle-hover : transparent;
                    FluentIcon {
                        name: "chevron_down";
                        width: 10px;
                        height: 10px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        tint: Theme.text-secondary;
                    }
                    min-ta := TouchArea { clicked => { root.window-minimize(); } }
                }
                Rectangle {
                    width: 46px;
                    height: parent.height;
                    background: max-ta.has-hover ? Theme.subtle-hover : transparent;
                    FluentIcon {
                        name: root.is-maximized ? "arrow_minimize" : "square_multiple";
                        width: 10px;
                        height: 10px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        tint: Theme.text-secondary;
                    }
                    max-ta := TouchArea { clicked => { root.window-toggle-maximize(); } }
                }
                Rectangle {
                    width: 46px;
                    height: parent.height;
                    background: close-ta.has-hover ? #c42b1c : transparent;
                    FluentIcon {
                        name: "dismiss";
                        width: 10px;
                        height: 10px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        tint: close-ta.has-hover ? #ffffff : Theme.text-secondary;
                    }
                    close-ta := TouchArea { clicked => { root.window-close(); } }
                }
            }

        }

        // ================= TAB STRIP =================
        Rectangle {
            height: Theme.tab-height;
            background: Theme.solid-secondary;

            HorizontalLayout {
                padding-left: Theme.s2;
                padding-right: Theme.s2;
                padding-top: 6px;
                spacing: Theme.s1;
                alignment: start;

                for tab[i] in root.tabs: TabItem {
                    label: tab.title;
                    icon: tab.icon;
                    active: i == root.active-tab;
                    clicked => { root.select-tab(i); }
                    closed => { root.close-tab(i); }
                    right-clicked => { root.tab-context-menu(i, self.absolute-position.x, self.absolute-position.y); }
                }
                Rectangle {
                    width: 32px;
                    height: 30px;
                    border-radius: Theme.r-sm;
                    background: plus-ta.pressed ? Theme.subtle-pressed
                        : plus-ta.has-hover ? Theme.subtle-hover : transparent;
                    FluentIcon {
                        name: "add";
                        width: 14px;
                        height: 14px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        tint: Theme.text-secondary;
                    }
                    plus-ta := TouchArea { clicked => { root.new-tab(); } }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        // ================= COMMAND BAR =================
        // Hàng lệnh chính của Files: New | Cut | Copy | Paste | Delete | Sort | View
        Rectangle {
            height: Theme.commandbar-height;
            background: Theme.solid-secondary;

            HorizontalLayout {
                padding-left: Theme.s2;
                padding-right: Theme.s2;
                spacing: Theme.s1;
                // alignment cố định để nhóm lệnh bám trái; chip clipboard vẫn
                // dạt phải nhờ Rectangle co giãn đứng trước nó.
                alignment: start;

                CommandButton {
                    label: "Mới";
                    icon: "add";
                    split: true;
                    clicked => { root.command("new-folder"); }
                    menu-clicked => { root.command("new-menu"); }
                }
                Rectangle { width: Theme.s1; }
                IconButton { icon: "cut"; accessible-text: "Cắt"; enabled: root.selection-count > 0; clicked => { root.command("cut"); } }
                IconButton { icon: "copy"; accessible-text: "Sao chép"; enabled: root.selection-count > 0; clicked => { root.command("copy"); } }
                IconButton { icon: "clipboard_paste"; accessible-text: "Dán"; enabled: root.clipboard-count > 0; clicked => { root.command("paste"); } }
                IconButton { icon: "rename"; accessible-text: "Đổi tên"; enabled: root.selection-count == 1; clicked => { root.command("rename"); } }
                IconButton { icon: "delete"; accessible-text: "Xoá"; enabled: root.selection-count > 0; clicked => { root.command("delete"); } }

                Rectangle { width: Theme.s1; }

                // Nén / giải nén: chỉ bật khi lựa chọn phù hợp.
                IconButton {
                    icon: "folder_zip";
                    accessible-text: "Nén thành ZIP";
                    enabled: root.selection-count > 0;
                    clicked => { root.command("compress"); }
                }
                IconButton {
                    icon: "folder_open";
                    accessible-text: "Giải nén";
                    enabled: root.selection-count == 1 && root.selection-is-archive;
                    clicked => { root.command("extract"); }
                }

                Rectangle { width: Theme.s1; }

                // chuyển kiểu xem
                IconButton {
                    icon: "list";
                    accessible-text: "Xem dạng danh sách";
                    checked: root.view-mode == 0;
                    clicked => { root.set-view-mode(0); }
                }
                IconButton {
                    icon: "grid";
                    accessible-text: "Xem dạng lưới";
                    checked: root.view-mode == 1;
                    clicked => { root.set-view-mode(1); }
                }
                IconButton {
                    icon: "eye";
                    accessible-text: "Ẩn hoặc hiện mục ẩn";
                    checked: root.show-hidden;
                    clicked => { root.toggle-hidden(); }
                }
                IconButton {
                    icon: "arrow_sort";
                    accessible-text: "Sắp xếp";
                    checked: root.sort-desc;
                    clicked => { root.sort-by(root.sort-column); }
                }

                Rectangle { horizontal-stretch: 1; }

                if root.clipboard-count > 0: ClipboardChip {
                    mode: root.clipboard-mode;
                    count: root.clipboard-count;
                }
            }
        }

        // ================= ĐỊA CHỈ / OMNIBAR =================
        Rectangle {
            height: Theme.addressbar-height + Theme.s2;
            background: Theme.solid-secondary;

            HorizontalLayout {
                padding-left: Theme.s2;
                padding-right: Theme.s2;
                spacing: Theme.s1;

                IconButton { icon: "arrow_left"; accessible-text: "Quay lại"; enabled: root.can-back; clicked => { root.go-back(); } }
                IconButton { icon: "arrow_right"; accessible-text: "Tiến tới"; enabled: root.can-forward; clicked => { root.go-forward(); } }
                IconButton { icon: "arrow_upload"; accessible-text: "Lên thư mục cha"; clicked => { root.go-up(); } }
                IconButton { icon: "arrow_clockwise"; accessible-text: "Làm mới"; clicked => { root.refresh(); } }

                Rectangle { width: Theme.s1; }

                // breadcrumb / omnibar
                Rectangle {
                    horizontal-stretch: 1;
                    height: Theme.addressbar-height;
                    border-radius: Theme.r-sm;
                    background: Theme.card;
                    border-width: 1px;
                    border-color: root.editing-address ? Theme.accent : Theme.stroke;
                    animate border-color { duration: 100ms; }

                    if root.editing-address: HorizontalLayout {
                        padding-left: Theme.s2;
                        padding-right: Theme.s2;
                        addr := TextInput {
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            color: Theme.text-primary;
                            font-size: Theme.font-body;
                            text: root.address-text;
                            accepted => { root.address-submitted(self.text); }
                        }
                    }
                    if !root.editing-address: HorizontalLayout {
                        padding-left: Theme.s2;
                        padding-right: Theme.s2;
                        spacing: Theme.s1;
                        alignment: start;
                        FluentIcon {
                            name: "folder";
                            width: 16px;
                            height: 16px;
                            y: (parent.height - self.height) / 2;
                            tint: Theme.glyph-folder;
                        }
                        // Một Text duy nhất: nằm trực tiếp trong layout nên tự nở
                        // theo nội dung. Nhiều Text rời sẽ bị layout ép cùng bề
                        // rộng và đè lên nhau.
                        // Vùng rê chuột để hiện đường dẫn đầy đủ: breadcrumb bị
                        // elide nên thư mục sâu không đọc hết được.
                        crumb-hover := TouchArea {
                            clicked => { }
                        }
                        Text {
                            text: root.crumb-text;
                            color: Theme.text-primary;
                            font-size: Theme.font-body;
                            vertical-alignment: center;
                            overflow: elide;

                            horizontal-stretch: 1;
                        }
                    }
                }

                Rectangle { width: Theme.s1; }

                // ô lọc nhanh: hiện khi người dùng bấm Ctrl+F
                if root.filtering: Rectangle {
                    width: 200px;
                    FluentTextBox {
                        placeholder: "Lọc theo tên";
                        leading-icon: "search";
                        text <=> root.filter-text;
                        accepted => { root.end-filter(); }
                        edited(t) => { root.filter-changed(t); }
                    }
                }
                if !root.filtering: IconButton { icon: "search"; accessible-text: "Tìm kiếm"; clicked => { root.start-filter(); } }

                if root.clipboard-count > 0: ClipboardChip {
                    mode: root.clipboard-mode;
                    count: root.clipboard-count;
                }

                IconButton {
                    icon: "panel_left";
                    accessible-text: "Ẩn hoặc hiện thanh bên";
                    checked: !root.show-sidebar;
                    clicked => { root.toggle-sidebar(); }
                }
                IconButton {
                    icon: "panel_right";
                    accessible-text: "Ẩn hoặc hiện panel xem trước";
                    checked: root.show-preview;
                    clicked => { root.toggle-preview(); }
                }
            }
        }

        // ================= THÂN =================
        HorizontalLayout {
            vertical-stretch: 1;

            // ---- Sidebar ----
            if root.show-sidebar: Rectangle {
                width: Theme.sidebar-width;
                background: Theme.solid-secondary;
                VerticalLayout {
                    padding-top: Theme.s2;
                    padding-bottom: Theme.s2;
                    spacing: 0px;

                    ScrollView {
                        VerticalLayout {
                            padding-left: Theme.s2;
                            padding-right: Theme.s2;
                            spacing: 1px;

                            for item in root.pinned: SidebarItem {
                                label: item.label;
                                icon: item.icon;
                                glyph: item.glyph;
                                indent: item.indent;
                                expandable: item.expandable;
                                expanded: item.expanded;
                                active: root.address-text == item.path;
                                clicked => { root.sidebar-activated(item.id); }
                                toggle-expanded => { root.sidebar-toggled(item.id); }
                            }

                            Rectangle { height: Theme.s3; }
                            Rectangle {
                                height: 28px;
                                Text {
                                    x: Theme.s2;
                                    text: "Ổ đĩa";
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-caption;
                                    font-weight: Theme.weight-semibold;
                                    vertical-alignment: center;
                                }
                            }
                            for item in root.drives: SidebarItem {
                                label: item.label;
                                icon: item.icon;
                                glyph: item.glyph;
                                indent: item.indent;
                                expandable: item.expandable;
                                expanded: item.expanded;
                                active: root.address-text == item.path;
                                clicked => { root.sidebar-activated(item.id); }
                                toggle-expanded => { root.sidebar-toggled(item.id); }
                            }
                        }
                    }
                }
            }

            // ---- Vùng nội dung ----
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.file-area;
                clip: true;

                if root.error-text != "": Rectangle {
                    background: Theme.file-area;
                    VerticalLayout {
                        alignment: center;
                        spacing: Theme.s3;
                        padding: Theme.s6;
                        FluentIcon {
                            name: "info";
                            width: 40px;
                            height: 40px;
                            tint: Theme.text-tertiary;
                        }
                        Text {
                            text: root.error-text;
                            color: Theme.text-secondary;
                            font-size: Theme.font-body;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        FluentButton {
                            label: "Tải lại";
                            icon: "arrow_clockwise";
                            clicked => { root.refresh(); }
                        }
                    }
                }

                if root.error-text == "": Rectangle {
                    // Lớp nền nhận chuột phải/double-click ở vùng trống. Khai báo
                    // TRƯỚC nội dung và định vị tuyệt đối: nếu để nó là con của
                    // VerticalLayout thì layout chia cho nó một nửa chiều cao.
                    TouchArea {
                        clicked => { root.command("clear-selection"); }
                        double-clicked => { root.go-up(); }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                root.background-context-menu(self.mouse-x, self.mouse-y);
                            }
                        }
                    }

                    VerticalLayout {
                    // hàng tiêu đề cột (chỉ ở details view)
                    if root.view-mode == 0: Rectangle {
                        height: Theme.header-height;
                        background: Theme.file-area;
                        HorizontalLayout {
                            // Bề rộng cột cố định: header và hàng dữ liệu dùng
                            // cùng token nên không thể lệch, và tên dài chỉ bị
                            // cắt chứ không đẩy cột khác.
                            padding-left: Theme.s1 + Theme.list-pad;
                            padding-right: Theme.s1 + Theme.list-pad;
                            spacing: 0px;

                            Rectangle {
                                width: Theme.col-name;
                                Text {
                                    x: Theme.name-text-indent;
                                    width: parent.width - Theme.name-text-indent;
                                    text: "Tên" + (root.sort-column == "name" ? (root.sort-desc ? "  ↓" : "  ↑") : "");
                                    color: root.sort-column == "name" ? Theme.text-primary : Theme.text-secondary;
                                    font-size: Theme.font-caption;
                                    font-weight: Theme.weight-semibold;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                TouchArea { clicked => { root.sort-by("name"); } }
                            }
                            Rectangle {
                                width: Theme.col-modified;
                                Text {
                                    width: parent.width;
                                    text: "Ngày sửa" + (root.sort-column == "modified" ? (root.sort-desc ? "  ↓" : "  ↑") : "");
                                    color: root.sort-column == "modified" ? Theme.text-primary : Theme.text-secondary;
                                    font-size: Theme.font-caption;
                                    font-weight: Theme.weight-semibold;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                TouchArea { clicked => { root.sort-by("modified"); } }
                            }
                            Rectangle {
                                width: Theme.col-kind;
                                Text {
                                    width: parent.width;
                                    text: "Loại" + (root.sort-column == "kind" ? (root.sort-desc ? "  ↓" : "  ↑") : "");
                                    color: root.sort-column == "kind" ? Theme.text-primary : Theme.text-secondary;
                                    font-size: Theme.font-caption;
                                    font-weight: Theme.weight-semibold;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                TouchArea { clicked => { root.sort-by("kind"); } }
                            }
                            // Ô trống cho cột trạng thái git, để tiêu đề và dữ
                            // liệu thẳng cột.
                            Rectangle { width: 16px; }
                            Rectangle {
                                width: Theme.col-size;
                                Text {
                                    width: parent.width;
                                    text: "Kích thước" + (root.sort-column == "size" ? (root.sort-desc ? "  ↓" : "  ↑") : "");
                                    color: root.sort-column == "size" ? Theme.text-primary : Theme.text-secondary;
                                    font-size: Theme.font-caption;
                                    font-weight: Theme.weight-semibold;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                TouchArea { clicked => { root.sort-by("size"); } }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            width: parent.width;
                            background: Theme.stroke-divider;
                        }
                    }

                    // danh sách
                    ScrollView {
                        VerticalLayout {
                            padding: Theme.s1;
                            spacing: 0px;

                            // Trạng thái rỗng: một khung trắng không nói được gì,
                            // người dùng không biết thư mục trống hay app hỏng.
                            if root.rows.length == 0 && !root.busy && root.error-text == "": Rectangle {
                                height: 160px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: Theme.s3;
                                    FluentIcon {
                                        name: "folder_open";
                                        width: 32px;
                                        height: 32px;
                                        tint: Theme.text-tertiary;
                                    }
                                    Text {
                                        text: "Thư mục này trống";
                                        color: Theme.text-secondary;
                                        font-size: Theme.font-body;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Kéo tệp vào đây, hoặc dùng nút Mới để tạo mục đầu tiên.";
                                        color: Theme.text-tertiary;
                                        font-size: Theme.font-caption;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                            if root.view-mode == 0: VerticalLayout {
                                spacing: 0px;
                                for row[i] in root.rows: Rectangle {
                                    height: Theme.row-height;
                                    border-radius: Theme.r-sm;
                                    background: row.selected ? Theme.accent-subtle
                                        : rta.has-hover ? Theme.subtle-hover
                                        : transparent;
                                    animate background { duration: 70ms; }

                                    HorizontalLayout {
                                        // Cùng token với header.
                                        padding-left: Theme.list-pad;
                                        padding-right: Theme.list-pad;
                                        spacing: 0px;

                                        // Cột 1: icon + tên, bề rộng cố định.
                                        HorizontalLayout {
                                            width: Theme.col-name;
                                            spacing: Theme.icon-gap;
                                            HorizontalLayout {
                                                // Icon: ảnh thật của Windows nếu có, ngược lại glyph Fluent.
                                                if row.has-icon-image: Image {
                                                    source: row.icon-image;
                                                    width: Theme.icon-size;
                                                    height: Theme.icon-size;
                                                    image-fit: contain;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                                if !row.has-icon-image: FluentIcon {
                                                    name: row.icon;
                                                    width: Theme.icon-size;
                                                    height: Theme.icon-size;
                                                    y: (parent.height - self.height) / 2;
                                                    tint: row.glyph;
                                                }
                                                Text {
                                                // width cố định + elide: tên dài bị cắt,
                                                // không đẩy các cột sau.
                                                // Trừ thẳng từ token cột, không hỏi parent.width:
                                                // hỏi parent trong layout sẽ tạo binding loop.
                                                width: Theme.col-name - Theme.icon-size - Theme.icon-gap;
                                                text: row.name;
                                                color: row.is-hidden ? Theme.text-tertiary : Theme.text-primary;
                                                font-size: Theme.font-body;
                                                vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                        Text {
                                            width: Theme.col-modified;
                                            text: row.modified;
                                            color: Theme.text-secondary;
                                            font-size: Theme.font-caption;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            width: Theme.col-kind;
                                            text: row.kind;
                                            color: Theme.text-secondary;
                                            font-size: Theme.font-caption;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        // Trạng thái git: một chữ cái, chỉ hiện khi
                                        // thư mục là repo và tệp có thay đổi.
                                        Rectangle {
                                            width: 16px;
                                            height: parent.height;
                                            if row.git-letter != "": Text {
                                                text: row.git-letter;
                                                color: row.git-color;
                                                font-size: Theme.font-caption;
                                                font-weight: Theme.weight-semibold;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            width: Theme.col-size;
                                            text: row.size;
                                            color: Theme.text-secondary;
                                            font-size: Theme.font-caption;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    rta := TouchArea {
                                        clicked => { }
                                        double-clicked => { root.open-row(i); }
                                        pointer-event(e) => {
                                            if (e.kind == PointerEventKind.down) {
                                                if (e.button == PointerEventButton.right) {
                                                    root.select-row(i, 0);
                                                    root.row-context-menu(i, self.mouse-x, self.mouse-y);
                                                } else if (e.button == PointerEventButton.left) {
                                                    // Chuyển modifier xuống Rust: Ctrl = thêm/bớt
                                                    // một mục, Shift = chọn cả khoảng.
                                                    root.select-row(
                                                        i,
                                                        e.modifiers.control ? 2 : (e.modifiers.shift ? 1 : 0)
                                                    );
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.view-mode == 1: VerticalLayout {
                                spacing: Theme.s1;
                                // Slint's GridLayout does not wrap: rows must be
                                // grouped in Rust (see `format::chunk_rows`).
                                for line in root.grid-rows: HorizontalLayout {
                                    spacing: Theme.s1;
                                    alignment: start;
                                    for row in line: Rectangle {
                                        height: Theme.grid-tile;
                                        width: Theme.grid-tile;
                                        border-radius: Theme.r-md;
                                        background: row.selected ? Theme.accent-subtle
                                            : gta.has-hover ? Theme.subtle-hover : transparent;
                                        VerticalLayout {
                                            padding: Theme.s2;
                                            spacing: Theme.s1;
                                            alignment: center;
                                            FluentIcon {
                                                name: row.icon;
                                                width: 40px;
                                                height: 40px;
                                                tint: row.glyph;
                                            }
                                            Text {
                                                text: row.name;
                                                color: Theme.text-primary;
                                                font-size: Theme.font-caption;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                                wrap: word-wrap;
                                                max-height: 32px;
                                            }
                                        }
                                        gta := TouchArea {
                                            clicked => { }
                                            double-clicked => { root.open-row(row.index); }
                                            pointer-event(e) => {
                                                if (e.kind == PointerEventKind.down) {
                                                    if (e.button == PointerEventButton.right) {
                                                        root.select-row(row.index, 0);
                                                        root.row-context-menu(row.index, self.mouse-x, self.mouse-y);
                                                    } else if (e.button == PointerEventButton.left) {
                                                        root.select-row(
                                                            row.index,
                                                            e.modifiers.control ? 2 : (e.modifiers.shift ? 1 : 0)
                                                        );
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // vùng trống: chuột phải ra menu nền, double-click lên một cấp
                }
                }
            }

            // ---- Preview pane ----
            if root.show-preview: Rectangle {
                width: Theme.preview-width;
                background: Theme.solid-secondary;
                VerticalLayout {
                    padding: Theme.s4;
                    spacing: Theme.s2;

                    // Tiêu đề + bảng thuộc tính ghim trên cùng: người dùng chọn
                    // một mục là thấy ngay thông tin, không phải cuộn.
                    // `alignment: start` giữ khối này ở đỉnh; nếu để mặc định
                    // VerticalLayout sẽ chia đều và đẩy nó xuống đáy panel.
                    VerticalLayout {
                        spacing: Theme.s1;
                        alignment: start;
                        Text {
                            text: root.preview-kind == "none" ? "Chọn một mục để xem trước" : root.preview-title;
                            color: Theme.text-primary;
                            font-size: Theme.font-subtitle;
                            font-weight: Theme.weight-semibold;
                            overflow: elide;
                        }

                        if root.props.length > 0: Rectangle {
                            height: root.props.length * 24px;
                            VerticalLayout {
                                spacing: 0px;
                                for p in root.props: Rectangle {
                                    height: 24px;
                                    HorizontalLayout {
                                        spacing: Theme.s2;
                                        Text {
                                            width: 92px;
                                            text: p.label;
                                            color: Theme.text-tertiary;
                                            font-size: Theme.font-caption;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: p.value;
                                            color: Theme.text-secondary;
                                            font-size: Theme.font-caption;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Ảnh/văn bản chiếm phần còn lại.
                    if root.preview-kind == "image" || root.preview-kind == "text": Rectangle {
                        vertical-stretch: 1;
                        background: Theme.solid-base;
                        border-radius: Theme.r-md;
                        border-width: 1px;
                        border-color: Theme.stroke;
                        clip: true;
                        if root.preview-kind == "image": Image {
                            source: root.preview-image;
                            image-fit: contain;
                            width: parent.width - Theme.s3 * 2;
                            height: parent.height - Theme.s3 * 2;
                            x: Theme.s3;
                            y: Theme.s3;
                        }
                        if root.preview-kind == "text": ScrollView {
                            VerticalLayout {
                                padding: Theme.s3;
                                Text {
                                    text: root.preview-text;
                                    color: Theme.text-secondary;
                                    font-family: "Cascadia Mono";
                                    font-size: Theme.font-caption;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ================= STATUS BAR =================
        Rectangle {
            height: Theme.status-height;
            background: Theme.solid-secondary;
            border-width: 1px;
            border-color: Theme.stroke-divider;

            HorizontalLayout {
                padding-left: Theme.s3;
                padding-right: Theme.s3;
                spacing: Theme.s3;
                alignment: start;

                Text {
                    text: root.status-primary;
                    color: Theme.text-secondary;
                    font-size: Theme.font-caption;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.status-secondary != "": Rectangle {
                    width: 1px;
                    height: 12px;
                    y: (parent.height - self.height) / 2;
                    background: Theme.stroke-strong;
                }
                Text {
                    text: root.status-secondary;
                    color: Theme.text-secondary;
                    font-size: Theme.font-caption;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle { horizontal-stretch: 1; }
                if root.busy: HorizontalLayout {
                    spacing: Theme.s2;
                    // Thanh tiến trình: chỉ hiện khi biết tỉ lệ thật, để không
                    // vẽ một thanh đứng yên trông như app treo.
                    if root.progress > 0: Rectangle {
                        width: 80px;
                        height: 4px;
                        border-radius: 2px;
                        y: (parent.height - self.height) / 2;
                        background: Theme.stroke-divider;
                        Rectangle {
                            width: parent.width * root.progress;
                            height: parent.height;
                            border-radius: 2px;
                            background: Theme.accent;
                        }
                    }
                    Text {
                        text: root.busy-text;
                        color: Theme.text-secondary;
                        font-size: Theme.font-caption;
                        vertical-alignment: center;
                    }
                    if root.cancellable: Rectangle {
                        width: 52px;
                        height: 20px;
                        border-radius: Theme.r-sm;
                        y: (parent.height - self.height) / 2;
                        background: cancel-ta.has-hover ? Theme.subtle-pressed : Theme.subtle-hover;
                        Text {
                            text: "Huỷ";
                            color: Theme.text-primary;
                            font-size: Theme.font-caption;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        cancel-ta := TouchArea {
                            clicked => { root.cancel-operation(); }
                        }
                    }
                }
                Text {
                    text: root.status-tertiary;
                    color: Theme.text-tertiary;
                    font-size: Theme.font-caption;
                    vertical-alignment: center;
                }
                // Đặt app làm trình duyệt tệp mặc định. Cần người dùng xác
                // nhận: hành động này đổi thứ Windows dùng cho mọi thao tác mở
                // thư mục sau này, và Windows vẫn hỏi lại lần nữa ở Settings.
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: Theme.r-sm;
                    y: (parent.height - self.height) / 2;
                    background: default-ta.has-hover ? Theme.subtle-hover : transparent;
                    FluentIcon {
                        name: "star";
                        width: 12px;
                        height: 12px;
                        x: 6px;
                        y: 6px;
                        tint: Theme.text-secondary;
                    }
                    default-ta := TouchArea { clicked => { root.command("register-assoc"); } }
                }
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: Theme.r-sm;
                    y: (parent.height - self.height) / 2;
                    background: theme-ta.has-hover ? Theme.subtle-hover : transparent;
                    FluentIcon {
                        name: "weather_moon";
                        width: 12px;
                        height: 12px;
                        x: 6px;
                        y: 6px;
                        tint: Theme.text-secondary;
                    }
                    theme-ta := TouchArea { clicked => { root.toggle-theme(); } }
                }
            }
        }
    }

    // ================= COMMAND PALETTE =================
    // Hộp nổi ở giữa trên cùng, gõ để lọc lệnh — giống Files và VS Code.
    if root.palette-open: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #00000040;
        TouchArea { clicked => { root.close-palette(); } }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 80px;
            width: 560px;
            height: 420px;
            border-radius: Theme.r-lg;
            background: Theme.solid-tertiary;
            border-width: 1px;
            border-color: Theme.stroke-strong;
            drop-shadow-blur: 32px;
            drop-shadow-color: #00000040;
            drop-shadow-offset-y: 8px;

            VerticalLayout {
                padding: Theme.s3;
                spacing: Theme.s2;

                Rectangle {
                    height: 36px;
                    palette-input := TextInput {
                        vertical-alignment: center;
                        color: Theme.text-primary;
                        font-size: Theme.font-subtitle;
                        text: root.palette-query;
                        edited => { root.palette-changed(self.text); }
                        accepted => {
                            if (root.palette-items.length > 0) {
                                root.palette-accepted(root.palette-items[0].id);
                            }
                        }
                    }
                    init => { palette-input.focus(); }
                }

                Rectangle {
                    height: 1px;
                    width: parent.width;
                    background: Theme.stroke-divider;
                }

                ScrollView {
                    VerticalLayout {
                        spacing: 1px;
                        for item in root.palette-items: Rectangle {
                            height: 32px;
                            border-radius: Theme.r-sm;
                            background: pi.has-hover ? Theme.subtle-hover : transparent;
                            HorizontalLayout {
                                padding-left: Theme.s2;
                                padding-right: Theme.s2;
                                spacing: Theme.s2;
                                FluentIcon {
                                    name: item.icon;
                                    width: 16px;
                                    height: 16px;
                                    y: (parent.height - self.height) / 2;
                                    tint: Theme.text-secondary;
                                }
                                Text {
                                    text: item.label;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-body;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                if item.shortcut != "": Text {
                                    text: item.shortcut;
                                    color: Theme.text-tertiary;
                                    font-size: Theme.font-caption;
                                    vertical-alignment: center;
                                }
                            }
                            pi := TouchArea { clicked => { root.palette-accepted(item.id); } }
                        }
                        if root.palette-items.length == 0: Rectangle {
                            height: 60px;
                            Text {
                                text: "Không có lệnh nào khớp";
                                color: Theme.text-tertiary;
                                font-size: Theme.font-body;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }

    // ================= MENU NGỮ CẢNH =================
    if root.menu-open: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: transparent;
        TouchArea { clicked => { root.dismiss-menu(); } }
        MenuPopup {
            x: min(root.menu-x, root.width - 240px);
            y: min(root.menu-y, root.height - 300px);
            items: root.menu-items;
            activated(id) => { root.menu-activated(id); }
        }
    }

    // ================= HỘP THOẠI =================
    if root.dialog-open: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #00000066;
        TouchArea { clicked => { root.dialog-cancel(); } }

        DialogSurface {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            title: root.dialog-title;
            primary-label: root.dialog-primary-label;
            secondary-label: root.dialog-secondary-label;
            // Lệnh tự sinh tên (thư mục/tệp mới) vẫn bấm được khi ô trống:
            // Rust sẽ chọn "Thư mục mới (2)" thay vì bắt người dùng gõ trước.
            primary-enabled: !root.dialog-has-input
                || root.dialog-value != ""
                || root.dialog-allows-empty;
            primary => { root.dialog-confirm(root.dialog-value); }
            secondary => { root.dialog-secondary(); }
            cancelled => { root.dialog-cancel(); }

            if root.dialog-kind == "confirm-delete" || root.dialog-kind == "confirm-delete-permanent" || root.dialog-kind == "confirm-default" || root.dialog-kind == "paste-conflict" || root.dialog-kind == "confirm-rotate": Text {
                text: root.dialog-text;
                color: Theme.text-secondary;
                font-size: Theme.font-body;
                wrap: word-wrap;
            }
            if root.dialog-kind != "confirm-delete" && root.dialog-kind != "confirm-delete-permanent" && root.dialog-kind != "confirm-default" && root.dialog-kind != "paste-conflict" && root.dialog-kind != "confirm-rotate": Rectangle {
                // Ô nhập phải có khung nhìn thấy được: trước đây nó trong suốt
                // nên hộp thoại đổi tên / tạo mới trông như không có chỗ gõ.
                height: 36px;
                border-radius: Theme.r-sm;
                background: Theme.solid-base;
                border-width: 1px;
                border-color: dialog-input.has-focus ? Theme.accent : Theme.stroke-strong;
                animate border-color { duration: 100ms; }
                HorizontalLayout {
                    padding-left: Theme.s3;
                    padding-right: Theme.s3;
                    dialog-input := TextInput {
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        color: Theme.text-primary;
                        font-size: Theme.font-body;
                        single-line: true;
                        // Hai chiều: gõ là `dialog-value` đổi ngay. Trước đây
                        // binding một chiều cộng `edited` gán ngược lại, nên
                        // giá trị không tới được Rust và nút "Tạo" đứng im.
                        text <=> root.dialog-value;
                        accepted => { root.dialog-confirm(self.text); }
                        // Focus ngay khi hộp thoại mở, nếu không người dùng gõ
                        // mà không có gì xảy ra.
                        init => { self.focus(); }
                    }
                }
            }
        }
    }

    public function end-edit-address() {
        root.editing-address = false;
        key-root.focus();
    }
}
