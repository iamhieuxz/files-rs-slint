import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { IconButton, NavItem, TabItem } from "widgets.slint";
import { Icon } from "icons.slint";

export struct FileRow {
    name: string,
    path: string,
    is-dir: bool,
    size: string,
    modified: string,
    kind: string,
}

export struct NavEntry {
    label: string,
    path: string,
}

export struct TabInfo {
    title: string,
    path: string,
}

export component AppWindow inherits Window {
    title: "Files RS";
    preferred-width: 1180px;
    preferred-height: 740px;
    background: Theme.canvas;
    default-font-family: "Segoe UI";
    init => { fs.focus(); }

    // ---- dữ liệu vào ----
    in-out property <string> address-text;
    in-out property <[FileRow]> rows;
    in-out property <[NavEntry]> drives;
    in-out property <[NavEntry]> quick-access;
    in-out property <string> current-path;
    in-out property <int> selected-index: -1;
    in-out property <string> sort-column: "name";
    in-out property <bool> sort-desc: false;
    in-out property <bool> can-back: false;
    in-out property <bool> can-forward: false;
    in-out property <string> status-text;
    in-out property <string> error-text;
    in-out property <[TabInfo]> tabs;
    in-out property <int> active-tab: 0;

    // preview
    in-out property <string> preview-kind: "none";   // none | image | text | info
    in-out property <image> preview-image;
    in-out property <string> preview-text;
    in-out property <string> preview-title;
    in-out property <string> preview-meta;

    // Độ rộng panel preview, người dùng kéo được
    in-out property <length> preview-width: 300px;

    callback navigate(string);
    callback open-row(int);
    callback select-row(int);
    callback go-back();
    callback go-forward();
    callback go-up();
    callback refresh();
    callback address-submitted(string);
    callback sort-by(string);
    callback new-tab();
    callback close-tab(int);
    callback select-tab(int);
    fs := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && event.text == "l") {
                address.focus();
                return accept;
            }
            if (event.text == Key.Backspace && !address.has-focus) {
                root.go-up();
                return accept;
            }
            if (event.text == Key.F5) {
                root.refresh();
                return accept;
            }
            if (event.text == Key.Return && !address.has-focus && root.selected-index >= 0) {
                root.open-row(root.selected-index);
                return accept;
            }
            if (event.text == Key.LeftArrow && event.modifiers.alt) {
                root.go-back();
                return accept;
            }
            if (event.text == Key.RightArrow && event.modifiers.alt) {
                root.go-forward();
                return accept;
            }
            if (event.text == Key.UpArrow && !address.has-focus) {
                root.select-row(max(0, root.selected-index - 1));
                return accept;
            }
            if (event.text == Key.DownArrow && !address.has-focus) {
                root.select-row(min(root.rows.length - 1, root.selected-index + 1));
                return accept;
            }
            reject
        }

    HorizontalLayout {
        // ===== Sidebar =====
        Rectangle {
            width: Theme.sidebar-width;
            background: Theme.panel;
            border-width: 0px;
            VerticalLayout {
                padding: Theme.s2;
                padding-top: Theme.s4;
                spacing: Theme.s1;

                Rectangle {
                    height: 24px;
                    Text {
                        x: Theme.s2;
                        text: "Truy cập nhanh";
                        color: Theme.text-muted;
                        font-size: Theme.font-label;
                        vertical-alignment: center;
                    }
                }
                for item in quick-access: NavItem {
                    label: item.label;
                    icon: item.label == "Desktop" || item.label == "Màn hình nền" ? "folder"
                        : item.label == "Downloads" || item.label == "Tải xuống" ? "folder"
                        : "folder";
                    active: root.current-path == item.path;
                    clicked => { root.navigate(item.path); }
                }

                Rectangle { height: Theme.s4; }

                Rectangle {
                    height: 24px;
                    Text {
                        x: Theme.s2;
                        text: "Ổ đĩa";
                        color: Theme.text-muted;
                        font-size: Theme.font-label;
                        vertical-alignment: center;
                    }
                }
                for item in drives: NavItem {
                    label: item.label;
                    icon: "drive";
                    active: root.current-path == item.path;
                    clicked => { root.navigate(item.path); }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }

        // ===== Khu vực chính =====
        VerticalLayout {
            horizontal-stretch: 1;

            // Thanh tab
            Rectangle {
                height: Theme.tab-height;
                background: Theme.panel;
                HorizontalLayout {
                    padding-left: Theme.s2;
                    padding-right: Theme.s2;
                    spacing: Theme.s1;
                    alignment: start;
                    for tab[i] in root.tabs: TabItem {
                        label: tab.title;
                        active: i == root.active-tab;
                        clicked => { root.select-tab(i); }
                        closed => { root.close-tab(i); }
                    }
                    Rectangle {
                        width: 32px;
                        height: 28px;
                        border-radius: Theme.r-sm;
                        y: (parent.height - self.height) / 2;
                        background: plus-ta.pressed ? Theme.pressed
                            : plus-ta.has-hover ? Theme.hover : transparent;
                        Icon { name: "plus"; width: 14px; height: 14px; tint: Theme.text-secondary; x: 9px; y: 7px; }
                        plus-ta := TouchArea { clicked => { root.new-tab(); } }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }

            // Thanh lệnh: nút điều hướng + thanh địa chỉ
            Rectangle {
                height: Theme.toolbar-height;
                background: Theme.card;
                HorizontalLayout {
                    padding-left: Theme.s2;
                    padding-right: Theme.s3;
                    spacing: Theme.s1;
                    alignment: center;
                    IconButton { icon: "back"; enabled: root.can-back; clicked => { root.go-back(); } }
                    IconButton { icon: "forward"; enabled: root.can-forward; clicked => { root.go-forward(); } }
                    IconButton { icon: "up"; clicked => { root.go-up(); } }
                    IconButton { icon: "refresh"; clicked => { root.refresh(); } }
                    Rectangle { width: Theme.s2; }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: Theme.r-sm;
                        background: #00000040;
                        border-width: 1px;
                        border-color: address.has-focus ? Theme.accent : Theme.border;
                        animate border-color { duration: 120ms; }
                        HorizontalLayout {
                            padding-left: Theme.s3;
                            padding-right: Theme.s3;
                            Icon { name: "folder"; width: 14px; height: 14px; tint: Theme.icon-folder; y: (parent.height - self.height) / 2; }
                            address := TextInput {
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                color: Theme.text-primary;
                                font-size: Theme.font-body;
                                text: root.address-text;
                                accepted => { root.address-submitted(self.text); }
                            }
                        }
                    }
                    Rectangle { width: Theme.s2; }
                    Icon { name: "search"; width: 16px; height: 16px; tint: Theme.text-secondary; }
                }
            }

            // Hàng tiêu đề cột
            Rectangle {
                height: Theme.header-height;
                background: Theme.panel;
                border-width: 0px;
                HorizontalLayout {
                    padding-left: Theme.s4;
                    padding-right: Theme.s4;
                    Rectangle {
                        horizontal-stretch: 5;
                        Text {
                            x: 0;
                            text: "Tên" + (root.sort-column == "name" ? (root.sort-desc ? "  ↓" : "  ↑") : "");
                            color: root.sort-column == "name" ? Theme.text-primary : Theme.text-muted;
                            font-size: Theme.font-meta;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.sort-by("name"); } }
                    }
                    Rectangle {
                        horizontal-stretch: 2;
                        Text {
                            x: 0;
                            text: "Ngày sửa" + (root.sort-column == "modified" ? (root.sort-desc ? "  ↓" : "  ↑") : "");
                            color: root.sort-column == "modified" ? Theme.text-primary : Theme.text-muted;
                            font-size: Theme.font-meta;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.sort-by("modified"); } }
                    }
                    Rectangle {
                        horizontal-stretch: 2;
                        Text { x: 0; text: "Loại"; color: Theme.text-muted; font-size: Theme.font-meta; vertical-alignment: center; }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        Text {
                            text: "Kích thước" + (root.sort-column == "size" ? (root.sort-desc ? "  ↓" : "  ↑") : "");
                            color: root.sort-column == "size" ? Theme.text-primary : Theme.text-muted;
                            font-size: Theme.font-meta;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.sort-by("size"); } }
                    }
                }
            }

            // Danh sách + thanh kéo + preview
            HorizontalLayout {
                vertical-stretch: 1;

                // Danh sách
                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.canvas;
                    clip: true;
                    if root.error-text != "": Text {
                        x: Theme.s6;
                        y: Theme.s6;
                        width: parent.width - Theme.s6 * 2;
                        height: parent.height - Theme.s6 * 2;
                        text: root.error-text;
                        color: Theme.danger;
                        font-size: Theme.font-body;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    if root.error-text == "": ScrollView {
                        VerticalLayout {
                            padding: Theme.s1;
                            spacing: 0px;
                            for row[i] in root.rows: Rectangle {
                                height: Theme.row-height;
                                border-radius: Theme.r-sm;
                                background: i == root.selected-index ? Theme.selected
                                    : rta.has-hover ? Theme.hover
                                    : transparent;
                                animate background { duration: 90ms; }
                                HorizontalLayout {
                                    padding-left: Theme.s3;
                                    padding-right: Theme.s4;
                                    spacing: Theme.s2;
                                    HorizontalLayout {
                                        horizontal-stretch: 5;
                                        spacing: Theme.s2;
                                        Icon {
                                            name: row.is-dir ? "folder" : "file";
                                            tint: row.is-dir ? Theme.icon-folder : Theme.icon-file;
                                            width: 16px; height: 16px;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        Text {
                                            text: row.name;
                                            color: Theme.text-primary;
                                            font-size: Theme.font-body;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    Text { horizontal-stretch: 2; text: row.modified; color: Theme.text-secondary; font-size: Theme.font-meta; vertical-alignment: center; overflow: elide; }
                                    Text { horizontal-stretch: 2; text: row.kind; color: Theme.text-secondary; font-size: Theme.font-meta; vertical-alignment: center; overflow: elide; }
                                    Text { horizontal-stretch: 1; text: row.size; color: Theme.text-secondary; font-size: Theme.font-meta; horizontal-alignment: right; vertical-alignment: center; }
                                }
                                rta := TouchArea {
                                    clicked => { root.select-row(i); }
                                    double-clicked => { root.open-row(i); }
                                }
                            }
                        }
                    }
                }

                // Thanh kéo để đổi độ rộng preview
                splitter := Rectangle {
                    width: 6px;
                    background: splitter-ta.has-hover || splitter-ta.pressed ? Theme.border-strong : Theme.border;
                    animate background { duration: 100ms; }
                    splitter-ta := TouchArea {
                        mouse-cursor: ew-resize;
                        property <length> start-x;
                        property <length> start-w;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                self.start-x = self.mouse-x;
                                self.start-w = root.preview-width;
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                root.preview-width = max(Theme.preview-min,
                                    min(640px, self.start-w - (self.mouse-x - self.start-x)));
                            }
                        }
                    }
                }

                // Panel preview (kích thước theo preview-width)
                Rectangle {
                    width: root.preview-width;
                    background: Theme.panel;
                    VerticalLayout {
                        padding: Theme.s4;
                        spacing: Theme.s2;
                        Text {
                            text: root.preview-kind == "none" ? "Chọn một tệp để xem trước" : root.preview-title;
                            color: Theme.text-primary;
                            font-size: 14px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: root.preview-meta;
                            color: Theme.text-muted;
                            font-size: Theme.font-meta;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            background: #00000040;
                            border-radius: Theme.r-md;
                            clip: true;
                            if root.preview-kind == "image": Image {
                                source: root.preview-image;
                                image-fit: contain;
                                width: parent.width - Theme.s2 * 2;
                                height: parent.height - Theme.s2 * 2;
                                x: Theme.s2;
                                y: Theme.s2;
                            }
                            if root.preview-kind == "text": Text {
                                text: root.preview-text;
                                color: Theme.text-secondary;
                                font-family: "Consolas";
                                font-size: Theme.font-meta;
                                x: Theme.s3;
                                y: Theme.s3;
                                width: parent.width - Theme.s3 * 2;
                                wrap: word-wrap;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

            // Thanh trạng thái (chiều cao cố định)
            Rectangle {
                height: Theme.status-height;
                background: Theme.panel;
                HorizontalLayout {
                    padding-left: Theme.s4;
                    padding-right: Theme.s4;
                    Text {
                        text: root.status-text;
                        color: Theme.text-muted;
                        font-size: Theme.font-meta;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
    }
}
